<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/raven_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/main_title"
            android:textColor="@color/raven_text_primary"
            android:textSize="28sp"
            android:textStyle="bold"
            android:letterSpacing="0.2" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/main_subtitle"
            android:textColor="@color/raven_text_secondary"
            android:textSize="13sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="24dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="@color/raven_surface"
            app:layout_constraintDimensionRatio="1:1"
            android:id="@+id/previewContainer"
            android:layout_weight="1">

            <androidx.camera.view.PreviewView
                android:id="@+id/previewView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:scaleType="fillCenter" />

        </FrameLayout>

        <TextView
            android:id="@+id/textCameraStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/camera_status_off"
            android:textColor="@color/raven_accent"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textCameraMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/camera_permission_required"
            android:textColor="@color/raven_text_secondary"
            android:textSize="13sp" />
            
            <TextView
    android:id="@+id/textFaceStatus"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:text="@string/face_status_waiting"
    android:textColor="@color/raven_accent"
    android:textSize="16sp"
    android:textStyle="bold" />

<TextView
    android:id="@+id/textFaceCount"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:text=""
    android:textColor="@color/raven_text_secondary"
    android:textSize="13sp" />
    
    <TextView
    android:id="@+id/textLeftEye"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:text="@string/eye_label_left"
    android:textColor="@color/raven_text_primary"
    android:textSize="15sp" />

<TextView
    android:id="@+id/textRightEye"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:text="@string/eye_label_right"
    android:textColor="@color/raven_text_primary"
    android:textSize="15sp" />

<TextView
    android:id="@+id/textLeftProb"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:text=""
    android:textColor="@color/raven_text_secondary"
    android:textSize="12sp" />

<TextView
    android:id="@+id/textRightProb"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="2dp"
    android:text=""
    android:textColor="@color/raven_text_secondary"
    android:textSize="12sp" />
    
    <View
    android:layout_width="120dp"
    android:layout_height="1dp"
    android:layout_marginTop="12dp"
    android:background="@color/raven_surface" />

<TextView
    android:id="@+id/textBlinkState"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:text="@string/blink_state_format_default"
    android:textColor="@color/raven_text_primary"
    android:textSize="15sp" />

<TextView
    android:id="@+id/textBlinkCount"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:text="@string/blink_count_default"
    android:textColor="@color/raven_accent"
    android:textSize="15sp"
    android:textStyle="bold" />

<TextView
    android:id="@+id/textLastBlink"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:text=""
    android:textColor="@color/raven_text_secondary"
    android:textSize="13sp" />
    
    <View
    android:layout_width="120dp"
    android:layout_height="1dp"
    android:layout_marginTop="12dp"
    android:background="@color/raven_surface" />

<TextView
    android:id="@+id/textGestureEngine"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:text="@string/gesture_status_ready"
    android:textColor="@color/raven_accent"
    android:textSize="15sp"
    android:textStyle="bold" />

<TextView
    android:id="@+id/textGestureLastAction"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:textColor="@color/raven_text_primary"
    android:textSize="14sp" />

<TextView
    android:id="@+id/textGestureLastAt"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="2dp"
    android:textColor="@color/raven_text_secondary"
    android:textSize="12sp" />

<TextView
    android:id="@+id/textGestureCooldown"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="2dp"
    android:textColor="@color/raven_text_secondary"
    android:textSize="12sp" />
    
    <View
    android:layout_width="120dp"
    android:layout_height="1dp"
    android:layout_marginTop="12dp"
    android:background="@color/raven_surface" />

<TextView
    android:id="@+id/textBackgroundStatus"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:text="@string/background_status_stopped"
    android:textColor="@color/raven_accent"
    android:textSize="15sp"
    android:textStyle="bold" />

<LinearLayout
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:orientation="horizontal">

    <Button
        android:id="@+id/buttonStartBackground"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/background_action_start" />

    <Button
        android:id="@+id/buttonStopBackground"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="@string/background_action_stop" />
</LinearLayout>

<LinearLayout
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:orientation="horizontal">

    <Button
        android:id="@+id/buttonTestScroll"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/gesture_test_scroll" />

    <Button
        android:id="@+id/buttonTestLike"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="@string/gesture_test_like" />
</LinearLayout>

<TextView
    android:id="@+id/textClosureOrSequence"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="2dp"
    android:text=""
    android:textColor="@color/raven_text_secondary"
    android:textSize="13sp" />
    
    <TextView
    android:id="@+id/textCalibrationStatus"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:text="@string/calibration_status_required"
    android:textColor="@color/raven_accent"
    android:textSize="15sp"
    android:textStyle="bold" />
    
    <TextView
    android:id="@+id/textAccessibilityStatus"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:text="@string/accessibility_status_disabled"
    android:textColor="@color/raven_accent"
    android:textSize="15sp"
    android:textStyle="bold" />

<Button
    android:id="@+id/buttonAccessibility"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:text="@string/accessibility_action_enable" />

<TextView
    android:id="@+id/textAccessibilityHint"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:gravity="center"
    android:text="@string/accessibility_restricted_hint"
    android:textColor="@color/raven_text_secondary"
    android:textSize="12sp" />

<Button
    android:id="@+id/buttonCalibration"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:text="@string/calibration_action_open" />

<Button
    android:id="@+id/buttonResetCalibration"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:text="@string/calibration_action_reset" />

<Button
    android:id="@+id/buttonResetBlink"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:text="@string/blink_reset" />

        <Button
            android:id="@+id/buttonCameraAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:text="@string/camera_action_enable" />

    </LinearLayout>
</ScrollView>